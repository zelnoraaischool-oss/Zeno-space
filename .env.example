# =============================================================================
# zenospace 環境変数（Vercel の Project Settings > Environment Variables に設定）
# VITE_ で始まる値はブラウザに公開される。service_role キーなど秘密の値は書かないこと。
# =============================================================================

# データソース：未設定なら、Supabase の URL と公開鍵があれば supabase、なければ mock
# VITE_DATA_SOURCE=supabase

# --- Supabase ---
# Vercel の Supabase 連携が入れる NEXT_PUBLIC_SUPABASE_URL / NEXT_PUBLIC_SUPABASE_ANON_KEY のままでも読める
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
# 外部ログイン（Supabase の Authentication > Providers で有効にしたもの）：google / google,github
VITE_AUTH_PROVIDERS=

# --- マイグレーションの自動適用（ビルド時。ブラウザには渡らない）---
# Vercel の連携が入れる POSTGRES_URL_NON_POOLING でもよい。本番ビルド（VERCEL_ENV=production）のときだけ適用する
SUPABASE_DB_URL=
# MIGRATE=1   # プレビューや手元でも適用する

# --- Web Push（VAPID 公開鍵。秘密鍵は Supabase の Edge Function Secrets に置く）---
# 生成：npx web-push generate-vapid-keys
VITE_VAPID_PUBLIC_KEY=

# --- Cloudflare R2（画像の公開URL。独自ドメイン推奨：Q-03）---
VITE_R2_PUBLIC_BASE_URL=

# --- Cloudflare Turnstile（ボット対策のサイトキー）---
VITE_TURNSTILE_SITE_KEY=

# --- Sentry（任意。個人情報は送らない設定にする）---
VITE_SENTRY_DSN=

# --- モックの挙動（開発用）---
VITE_MOCK_LATENCY=120
VITE_MOCK_BOTS=true
